# Copy to .env.local and fill in real values. Never commit .env or .env.local.
# These are frontend build-time values only — they end up in the shipped JS bundle,
# so nothing secret belongs here. Backend secrets (Stripe, Acuity, ROLLER) belong in
# base44's own secrets manager, not in this file.
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=
